/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.

    Output layout (see docs/output.md). Publishing is an allowlist: there is no
    default publishDir, so a process publishes only if it has a rule below, and
    anything without one (alignment BAMs, decompressed references, per-sample
    summary rows) stays in the work directory.

        by_sample/<id>/...      everything for one sample, by stage
        by_<field>/<value>/     per-group reports (by_project, by_tag, ...)
        summary/                all-samples reports and tables
        run_info/               pipeline info, provenance, RO-Crate
----------------------------------------------------------------------------------------
*/

process {

    withName: 'FASTQC_RAW' {
        ext.args   = '--quiet'
        ext.prefix = { "${meta.id}_raw" }
    }

    withName: 'FASTQC_FINAL' {
        ext.args   = '--quiet'
        ext.prefix = { "${meta.id}_final" }
    }

    withName: 'FASTQC_RAW|FASTQC_FINAL' {
        publishDir = [
            path: { "${params.outdir}/by_sample/${meta.id}/reads_qc/fastqc" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FASTP_TRIM|FASTP_FINAL_QC' {
        memory = { 4.GB * task.attempt }
    }

    withName: 'FASTP_FINAL_QC' {
        // Measurement-only pass on the final reads - see
        // subworkflows/local/read_qc_and_dehosting.nf. discard_trimmed_pass:
        // true means fastp never writes trimmed reads at all here, so
        // distinguishing the report filename is just for clarity in MultiQC.
        ext.prefix = { "${meta.id}_final" }
        publishDir = [
            path: { "${params.outdir}/by_sample/${meta.id}/reads_qc/fastp" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FASTPLONG_FINAL_QC' {
        ext.prefix = { "${meta.id}_final" }
        publishDir = [
            path: { "${params.outdir}/by_sample/${meta.id}/reads_qc/fastplong" },
            mode: params.publish_dir_mode
        ]
    }

    // Read files are only published on request: --publish_dehosted_reads, or
    // per sample with the samplesheet's `publish_dehosted_reads` column. The
    // dehosting stats and fastp/fastplong reports are always published.
    withName: 'DEHOST' {
        publishDir = [
            path: { "${params.outdir}/by_sample/${meta.id}/dehost" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if( filename.endsWith('.fastq.gz') && !(params.publish_dehosted_reads || meta.publish_dehosted_reads) ) return null
                return filename
            }
        ]
    }

    // Trimmed reads from before dehosting still contain host reads, so they're
    // never published while dehosting runs. With --skip_dehosting they ARE the
    // final reads, so the same opt-in applies to them.
    withName: 'FASTP_TRIM|FASTPLONG_TRIM' {
        publishDir = [
            path: { "${params.outdir}/by_sample/${meta.id}/reads_qc/${task.process.contains('FASTPLONG') ? 'fastplong' : 'fastp'}" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if( filename.endsWith('.fastq.gz') && !(params.skip_dehosting && (params.publish_dehosted_reads || meta.publish_dehosted_reads)) ) return null
                return filename
            }
        ]
    }

    withName: 'SYLPH_PROFILE' {
        ext.args = '--estimate-unknown'
        publishDir = [
            path: { "${params.outdir}/by_sample/${meta.id}/species_id/sylph" },
            mode: params.publish_dir_mode
        ]
    }

    // One kraken2 run per (sample, database): the database name is in meta (set
    // in subworkflows/local/species_id.nf) so reports from several databases
    // don't collide. MultiQC reads these reports.
    withName: 'KRAKEN2_KRAKEN2' {
        ext.prefix = { "${meta.id}.${meta.kraken2_db}" }
        publishDir = [
            path: { "${params.outdir}/by_sample/${meta.id}/species_id/kraken2" },
            mode: params.publish_dir_mode,
            pattern: "*report.txt"
        ]
    }

    withName: 'SPECIES_CHECK' {
        ext.args = { "--kraken2-min-expected-pct ${params.kraken2_min_expected_pct} --kraken2-min-classified-pct ${params.kraken2_min_classified_pct} --kraken2-min-metagenomic-pct ${params.kraken2_min_metagenomic_pct}" }
        publishDir = [
            path: { "${params.outdir}/by_sample/${meta.id}/species_id" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FETCH_REFERENCE_GENOME' {
        // Not published: storeDir already keeps each genome in
        // --reference_genome_cache_dir (see the module's own comment). On by
        // default (network access assumed in deployment), so a failed/unreachable
        // fetch shouldn't sink the whole run: retry transient issues
        // (NCBI rate-limiting, a momentary network blip) a couple of times,
        // then give up gracefully rather than failing - the sample simply
        // ends up with no reference genome, same as if the stage were off
        // for it (see subworkflows/local/reference_genome.nf).
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
    }

    // Assembly is a routine entrypoint stage: a single library failing to
    // assemble (too shallow, an odd read set, a transient OOM) must not sink
    // the whole batch. Retry a couple of times - the base config scales
    // `memory` with `task.attempt`, so a retry also gets more RAM, covering
    // transient OOM - then give up gracefully rather than failing the run.
    // Same retry-then-ignore pattern as FETCH_REFERENCE_GENOME; an ignored
    // assembler just leaves that sample out of the assembly channel (its
    // assembly columns come back NA), exactly as if it had not reached the gate.
    withName: 'GENOME_SIZE' {
        publishDir = [
            path: { "${params.outdir}/by_sample/${meta.id}/assembly" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'SHOVILL' {
        // --gsize from the species-informed hint (meta.genome_size) - skips
        // The kmc genome-size estimation in Shovill, which segfaulted on
        // shallow data during validation. See subworkflows/local/assembly.nf.
        ext.args = { meta.genome_size ? "--gsize ${meta.genome_size}" : '' }
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
        publishDir = [
            path: { "${params.outdir}/by_sample/${meta.id}/assembly" },
            mode: params.publish_dir_mode,
            pattern: "contigs.fa",
            saveAs: { filename -> "${meta.id}.contigs.fa" }
        ]
    }

    withName: 'DRAGONFLYE' {
        // --gsize from the species-informed hint (meta.genome_size) - avoids
        // The genome-size estimation in Dragonflye, which produced a
        // catastrophic ~1kb estimate on shallow ONT data during validation.
        // See subworkflows/local/assembly.nf.
        ext.args = { meta.genome_size ? "--gsize ${meta.genome_size}" : '' }
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
        publishDir = [
            path: { "${params.outdir}/by_sample/${meta.id}/assembly" },
            mode: params.publish_dir_mode,
            pattern: "*.fa",
            // <id>.fa is the final assembly (what QC runs on); the dnaapler
            // copy, when there is one, is published beside it, not over it.
            saveAs: { filename -> filename.endsWith('.reoriented.fa') ? "${meta.id}.contigs.reoriented.fa" : "${meta.id}.contigs.fa" }
        ]
    }

    withName: 'QUAST' {
        publishDir = [
            path: { "${params.outdir}/by_sample/${meta.id}/assembly/quast" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CHECKM2_PREDICT' {
        ext.args   = '--force'
        publishDir = [
            path: { "${params.outdir}/by_sample/${meta.id}/assembly/checkm2" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'BUSCO_BUSCO' {
        publishDir = [
            path: { "${params.outdir}/by_sample/${meta.id}/assembly/busco" },
            mode: params.publish_dir_mode,
            pattern: "{short_summary.*,*-busco.batch_summary.txt}"
        ]
    }

    // Alignment-based QC (subworkflows/local/alignment_qc.nf). The minimap2
    // preset is per platform. MINIMAP2_ALIGN (the BAM), GUNZIP and
    // SAMTOOLS_FAIDX have no publish rule: they are intermediates.
    withName: 'MINIMAP2_ALIGN' {
        ext.args = { meta.platform == 'nanopore' ? '-x map-ont' : '-x sr' }
    }

    // riker multi: insert size only exists for paired Illumina. The WGS
    // collector drops unpaired reads and bases below Q20 by default, which
    // would discard nearly all of a Nanopore (or single-end) sample, so those
    // are counted - and Nanopore base qualities are not filtered.
    withName: 'RIKER_MULTI' {
        ext.args = {
            def paired = meta.platform == 'illumina' && !meta.single_end
            def tools  = paired ? 'alignment isize wgs gcbias' : 'alignment wgs gcbias'
            def wgs    = paired ? '' : '--wgs::include-unpaired-reads'
            def minbq  = meta.platform == 'nanopore' ? '--wgs::min-bq 0' : ''
            "--tools ${tools} ${wgs} ${minbq}".trim()
        }
        publishDir = [
            path: { "${params.outdir}/by_sample/${meta.id}/alignment" },
            mode: params.publish_dir_mode
        ]
    }

    // ASSEMBLY_SUMMARY and ALIGNMENT_SUMMARY write one row per sample; the
    // collected tables in summary/stage_tables/ are what gets published.

    // speccheck is a QC check, not an analysis: a failure for one sample
    // (e.g. an output it can not parse) must not sink the run. Retry, then
    // give up for that sample - its speccheck columns come back NA.
    withName: 'SPECCHECK_COLLECT' {
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
        publishDir = [
            path: { "${params.outdir}/by_sample/${meta.id}/speccheck" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'SPECCHECK_SUMMARY' {
        publishDir = [
            path: { "${params.outdir}/summary/speccheck" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.replaceFirst('^speccheck_report/', '') }
        ]
    }

    withName: 'SAMPLE_SUMMARY' {
        publishDir = [
            path: { "${params.outdir}/summary" },
            mode: params.publish_dir_mode
        ]
    }

    // Per-group reports (GROUP_REPORTS): one directory per group value under
    // by_<field>/, e.g. by_project/covid-19/ or by_tag/rerun/. Reports only:
    // the sample data stays in by_sample/.
    withName: 'MULTIQC_GROUP' {
        ext.args   = { "--title \"${params.multiqc_title ? params.multiqc_title + ' - ' : ''}${meta.field}: ${meta.value}\"" }
        publishDir = [
            path: { "${params.outdir}/${[project_id: 'by_project', tags: 'by_tag', sample_type: 'by_sample_type', platform: 'by_platform'][meta.field] ?: 'by_' + meta.field}/${meta.value}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FILTER_SAMPLE_SUMMARY' {
        publishDir = [
            path: { "${params.outdir}/${[project_id: 'by_project', tags: 'by_tag', sample_type: 'by_sample_type', platform: 'by_platform'][meta.field] ?: 'by_' + meta.field}/${meta.value}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/summary/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
