/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'FASTQC_RAW' {
        ext.args   = '--quiet'
        ext.prefix = { "${meta.id}_raw" }
    }

    withName: 'FASTQC_FINAL' {
        ext.args   = '--quiet'
        ext.prefix = { "${meta.id}_final" }
    }

    withName: 'FASTP_TRIM|FASTP_FINAL_QC' {
        memory = { 4.GB * task.attempt }
    }

    withName: 'FASTP_FINAL_QC' {
        // Measurement-only pass on the final reads - see
        // subworkflows/local/read_qc_and_dehosting.nf. discard_trimmed_pass:
        // true means fastp never writes trimmed reads at all here, so
        // distinguishing the report filename is just for clarity in MultiQC.
        ext.prefix = { "${meta.id}_final" }
    }

    withName: 'FASTPLONG_FINAL_QC' {
        ext.prefix = { "${meta.id}_final" }
    }

    // Read files are only published on request: --publish_dehosted_reads, or
    // per sample with the samplesheet's `publish_dehosted_reads` column. The
    // dehosting stats and fastp/fastplong reports are always published.
    withName: 'DEHOST' {
        publishDir = [
            path: { "${params.outdir}/dehost" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if( filename.equals('versions.yml') ) return null
                if( filename.endsWith('.fastq.gz') && !(params.publish_dehosted_reads || meta.publish_dehosted_reads) ) return null
                return filename
            }
        ]
    }

    // Trimmed reads from before dehosting still contain host reads, so they're
    // never published while dehosting runs. With --skip_dehosting they ARE the
    // final reads, so the same opt-in applies to them.
    withName: 'FASTP_TRIM|FASTPLONG_TRIM' {
        publishDir = [
            path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if( filename.equals('versions.yml') ) return null
                if( filename.endsWith('.fastq.gz') && !(params.skip_dehosting && (params.publish_dehosted_reads || meta.publish_dehosted_reads)) ) return null
                return filename
            }
        ]
    }

    withName: 'SYLPH_PROFILE' {
        ext.args = '--estimate-unknown'
        publishDir = [
            path: { "${params.outdir}/sylph" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SPECIES_CHECK' {
        publishDir = [
            path: { "${params.outdir}/species_id" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FETCH_REFERENCE_GENOME' {
        // Not published: storeDir already keeps each genome in
        // --reference_genome_cache_dir (see the module's own comment), so
        // turn off the default publishDir set at the top of this file -
        // otherwise every run copies the fetched references into
        // ${outdir}/fetch/. On by default now
        // (network access assumed in deployment), so a failed/unreachable
        // fetch shouldn't sink the whole run: retry transient issues
        // (NCBI rate-limiting, a momentary network blip) a couple of times,
        // then give up gracefully rather than failing - the sample simply
        // ends up with no reference genome, same as if the stage were off
        // for it (see subworkflows/local/reference_genome.nf).
        publishDir    = [ enabled: false ]
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
    }

    // Assembly is a routine entrypoint stage: a single library failing to
    // assemble (too shallow, an odd read set, a transient OOM) must not sink
    // the whole batch. Retry a couple of times - the base config scales
    // `memory` with `task.attempt`, so a retry also gets more RAM, covering
    // transient OOM - then give up gracefully rather than failing the run.
    // Same retry-then-ignore pattern as FETCH_REFERENCE_GENOME; an ignored
    // assembler just leaves that sample out of the assembly channel (its
    // assembly columns come back NA), exactly as if it had not reached the gate.
    withName: 'GENOME_SIZE' {
        publishDir = [
            path: { "${params.outdir}/assembly/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SHOVILL' {
        // --gsize from the species-informed hint (meta.genome_size) - skips
        // Shovills own kmc genome-size estimation, which segfaulted on
        // shallow data during validation. See subworkflows/local/assembly.nf.
        ext.args = { meta.genome_size ? "--gsize ${meta.genome_size}" : '' }
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
        publishDir = [
            path: { "${params.outdir}/assembly/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "contigs.fa",
            saveAs: { filename -> filename.equals('versions.yml') ? null : "${meta.id}.contigs.fa" }
        ]
    }

    withName: 'DRAGONFLYE' {
        // --gsize from the species-informed hint (meta.genome_size) - avoids
        // Dragonflyes own genome-size estimation, which produced a
        // catastrophic ~1kb estimate on shallow ONT data during validation.
        // See subworkflows/local/assembly.nf.
        ext.args = { meta.genome_size ? "--gsize ${meta.genome_size}" : '' }
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
        publishDir = [
            path: { "${params.outdir}/assembly/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*.fa",
            saveAs: { filename -> filename.equals('versions.yml') ? null : "${meta.id}.contigs.fa" }
        ]
    }

    withName: 'QUAST' {
        publishDir = [
            path: { "${params.outdir}/assembly/quast" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CHECKM2_PREDICT' {
        ext.args   = '--force'
        publishDir = [
            path: { "${params.outdir}/assembly/checkm2" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ASSEMBLY_SUMMARY' {
        publishDir = [
            path: { "${params.outdir}/assembly" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // speccheck is a QC check, not an analysis: a failure for one sample
    // (e.g. an output it can not parse) must not sink the run. Retry, then
    // give up for that sample - its speccheck columns come back NA.
    withName: 'SPECCHECK_COLLECT' {
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
        publishDir = [
            path: { "${params.outdir}/speccheck/samples" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SPECCHECK_SUMMARY' {
        publishDir = [
            path: { "${params.outdir}/speccheck" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename.replaceFirst('^speccheck_report/', '') }
        ]
    }

    withName: 'SAMPLE_SUMMARY' {
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Per-group reports (GROUP_REPORTS): one directory per group, named by
    // the grouping field and value, e.g. groups/project_id/covid-19/.
    withName: 'MULTIQC_GROUP' {
        ext.args   = { "--title \"${params.multiqc_title ? params.multiqc_title + ' - ' : ''}${meta.field}: ${meta.value}\"" }
        publishDir = [
            path: { "${params.outdir}/groups/${meta.field}/${meta.value}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FILTER_SAMPLE_SUMMARY' {
        publishDir = [
            path: { "${params.outdir}/groups/${meta.field}/${meta.value}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
