/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run BCCDC-PHL/threshold -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    // For memory-constrained machines (e.g. a laptop) compose with the `dev`
    // profile, which lowers these limits further: -profile test,dev,docker
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data: tiny in-repo synthetic fixtures (see tests/data/generate.py).
    // Covers both platforms - SAMPLE_PE (illumina) and SAMPLE_ONT (nanopore) -
    // and the reads are a host+microbe mix so the dehost step actually removes
    // reads. Fully offline.
    input  = "${projectDir}/tests/data/samplesheet.csv"

    // Small synthetic host reference that the host-derived reads map to, so the
    // removal path is exercised. Real runs point --dehost_reference at a masked
    // human reference.
    dehost_reference = "${projectDir}/tests/data/references/host_mini.fasta"

    // Tiny species-ID database (see tests/data/species_db/README.md). The
    // synthetic reads here are pseudo-random, so these won't return a
    // meaningful species call - they're exercised for real against known
    // species in the test_full profile instead.
    sylph_db             = "${projectDir}/tests/data/species_db/sylph/species_mini.syldb"
    species_id_manifest  = "${projectDir}/tests/data/species_db/manifest.csv"

    // The production default groups reports by project_id only; the tests also
    // group by tag, so tag grouping stays covered.
    multiqc_group_by     = 'project_id,tags'

    // Several databases per project (paths in the CSVs are relative to the
    // launch directory; the pipeline nf-test writes absolute copies):
    // project_a -> the default + a second database, project_b -> only the
    // second. Tiny SARS-CoV-2 kraken2 databases and a viral-only sylph one.
    kraken2_db           = "${projectDir}/tests/data/species_db/kraken2/sarscov2_mini"
    project_sylph_dbs    = "${projectDir}/tests/data/project_sylph_dbs.csv"
    project_kraken2_dbs  = "${projectDir}/tests/data/project_kraken2_dbs.csv"

    // Reference-genome fetch does real NCBI network I/O - on by default for
    // real deployments (see nextflow.config), but this profile stays
    // offline/deterministic, same as the rest of the test fixtures.
    skip_reference_genome_fetch = true

    // Assembly is on by default for real deployments (see nextflow.config), but
    // the synthetic fixtures here wouldn't assemble meaningfully - keep it off
    // so the smoke test stays fast.
    skip_assembly = true
}
