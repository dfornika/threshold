/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    BCCDC-PHL/threshold Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Input options
    input                      = null
    max_samples                = 0  // Only > 0 integers set a maximum number of samples (default is unlimited)

    // Dehosting options
    skip_dehosting             = false
    dehost_reference           = null   // Host reference: FASTA (optionally gzipped) or minimap2 .mmi index
    dehost_scrub_headers       = false  // Opt-in: replace read headers with anonymised indices

    // Species identification (sylph) + check against the samplesheet's expected_taxid
    skip_species_id            = false
    sylph_db                   = null   // Sylph genome database (.syldb) of reference genomes
    species_id_manifest        = null   // accession -> taxid/species_taxid/species_name CSV. Required when any sample has an expected_taxid (sylph's output has no taxonomy)

    // Reference genome (isolates only): from the samplesheet's `reference` column, else the species-ID top hit when it agrees with expected_taxid
    skip_reference_genome_fetch = false // On by default: planned deployment environments have network access. A per-accession fetch failure retries then degrades gracefully rather than failing the run - see conf/modules.config's FETCH_REFERENCE_GENOME errorStrategy. Offline test profiles (conf/test.config, conf/test_full.config) explicitly turn this back off. Local FASTA paths in the samplesheet are used either way.
    reference_genome_cache_dir = "${launchDir}/reference_genome_cache" // Directory to cache fetched reference genomes in, keyed by accession - override to a shared, persistent location to cache across runs

    // Assembly options (draft genome assembly + assembly QC for isolate samples)
    skip_assembly              = false  // On by default: assembly itself (Shovill/Dragonflye) needs no external DB. Offline test profiles (conf/test.config, conf/test_full.config) turn this off - the tiny/ultra-shallow fixtures don't assemble meaningfully.
    checkm2_db                 = null   // CheckM2 DIAMOND database (completeness/contamination). Optional external download - when unset, those columns are NA and only QUAST contiguity metrics are reported.
    // Species-specific QC thresholds (incl. QualiBact) with speccheck, for assembled isolates
    skip_speccheck             = false
    speccheck_criteria         = null   // Optional custom speccheck criteria CSV; default is speccheck's bundled criteria (QualiBact + generic)
    default_genome_size        = 5000000 // Backstop --gsize hint (bp) for the assemblers when there's no samplesheet genome_size, no reference, and no assets/genome_sizes.tsv taxid entry. Ballpark is fine - assembly quality is insensitive within ~2x.

    // MultiQC options
    multiqc_config             = null
    multiqc_title              = null
    multiqc_group_by           = 'project_id,tags' // Also write a MultiQC report + sample_summary.csv per value of these samplesheet fields (project_id, tags, sample_type, platform) under groups/<field>/<value>/; '' to turn off
    multiqc_logo               = null
    max_multiqc_email_size     = '25.MB'
    multiqc_methods_description = null

    // Compute environment
    task_tmpdir                  = true   // Give each task a TMPDIR inside its work dir - see conf/task_tmpdir.config

    // Boilerplate options
    outdir                       = null
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true
}

// Backwards compatibility for publishDir syntax
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm64 {
        process.arch            = 'arm64'
        // TODO https://github.com/nf-core/modules/issues/6694
        // For now if you're using arm64 you have to use wave for the sake of the maintainers
        // wave profile
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    test      { includeConfig 'conf/test.config'      }
    test_full { includeConfig 'conf/test_full.config' }
    dev       { includeConfig 'conf/dev.config'      }
}

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load BCCDC-PHL/threshold custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"


// Load BCCDC-PHL/threshold custom profiles from different institutions.
// TODO nf-core: Optionally, you can add a pipeline-specific nf-core config at https://github.com/nf-core/configs
// includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/pipeline/threshold.config" : "/dev/null"

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'



// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Per-task TMPDIR inside each task's work dir (always mounted in containers) -
// see conf/task_tmpdir.config. An `if` can't sit alongside config settings, so
// it's a conditional include, the same pattern nf-core uses for custom configs.
includeConfig params.task_tmpdir ? 'conf/task_tmpdir.config' : '/dev/null'

// Job names on grid executors (SLURM, PBS, SGE, ...). Nextflow's default is
// `nf-` + the full task name, e.g.
//   nf-BCCDCPHL_THRESHOLD_THRESHOLD_ASSEMBLY_ANALYSIS_SHOVILL_(SAMPLE)
// Drop the entry workflow's component (BCCDCPHL_THRESHOLD:) and attach the tag
// to the process name:
//   nf-THRESHOLD_ASSEMBLY_ANALYSIS_SHOVILL(SAMPLE)
// A custom jobName isn't sanitised by Nextflow (only truncated to 256
// characters), so replace the same characters its default does.
executor {
    jobName = { 'nf-' + task.name.replaceFirst(/^[^:]+:/, '').replace(' (', '(').replaceAll(/[ \/:@*?\n\t\r=]/, '_') }
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'BCCDC-PHL/threshold'
    contributors    = [
        // TODO nf-core: Update the field with the details of the contributors to your pipeline. New with Nextflow version 24.10.0
        [
            name: 'Dan Fornika',
            affiliation: '',
            email: '',
            github: '',
            contribution: [], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/BCCDC-PHL/threshold'
    description     = """QC and routine analysis for microbial genomics"""
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.10.4'
    version         = '0.1.0'
    doi             = ''
}

// Nextflow plugins
// All plugins in ONE block: with the legacy (v1) parser only the last
// `plugins {}` block takes effect, which silently dropped nf-schema when these
// were split across two blocks.
plugins {
    id 'nf-schema@2.7.3' // Validation of pipeline parameters and creation of an input channel from a sample sheet
    id 'nf-prov@1.7.0'   // Workflow Run RO-Crate provenance report
    // BCCDC-PHL provenance plugin, preliminary: built from
    // plugins/nf-bccdc-provenance/ in this repo and not published anywhere, so
    // it has to be installed locally before running the pipeline:
    //   (cd plugins/nf-bccdc-provenance && ./gradlew install)
    // See plugins/nf-bccdc-provenance/README.md.
    id 'nf-bccdc-provenance@0.2.0'
}

// nf-prov's WRROC report copies every local file given as a parameter whose
// schema format is "file-path" into the crate directory (here, outdir). Large
// reference data (dehost_reference, sylph_db, species_id_manifest, checkm2_db)
// therefore use "format": "path" in nextflow_schema.json instead: nf-schema
// still checks it exists, and nf-prov records the path without copying the
// file. Small inputs (the samplesheet, multiqc_config) stay "file-path" so a
// copy is kept with the results.
prov {
  enabled = true
  formats {
    wrroc {
      file = "${params.outdir}/ro-crate-metadata.json"
      overwrite = true
      license = "https://spdx.org/licenses/MIT"
    }
  }
}

validation {
    defaultIgnoreParams = ["genomes"]
    monochromeLogs = params.monochrome_logs
}
// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
