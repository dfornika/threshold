nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test") {

        when {
            // nf-test launches the pipeline from its own per-test directory,
            // so paths in the in-repo CSVs (relative to the repo root) wouldn't
            // resolve. Write copies with absolute paths instead - next to
            // (not inside) outdir, so they aren't part of the snapshot.
            def absolutize = { String source, String name ->
                def copy = new File(new File("${outputDir}").parentFile, name)
                copy.text = new File("${baseDir}/${source}").readLines().withIndex().collect { line, i ->
                    i == 0 ? line : line.split(',', -1).collect { field ->
                        field.startsWith('tests/') ? "${baseDir}/${field}" : field
                    }.join(',')
                }.join('\n') + '\n'
                return copy.toString()
            }

            params {
                input               = absolutize('tests/data/samplesheet.csv', 'samplesheet.abs.csv')
                project_sylph_dbs   = absolutize('tests/data/project_sylph_dbs.csv', 'project_sylph_dbs.abs.csv')
                project_kraken2_dbs = absolutize('tests/data/project_kraken2_dbs.csv', 'project_kraken2_dbs.abs.csv')
                outdir              = "$outputDir"
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: [
                // timestamped Nextflow reports and params dump
                'run_info/pipeline_info/*.{html,json,txt}',
                // pipeline files nf-prov's RO-Crate copies into outdir; their
                // content changes with every edit, so keep them out entirely
                '{README.md,main.nf,nextflow.config,nextflow_schema.json,ro-crate-metadata.json}',
                // per-group MultiQC internals: file names vary with the MultiQC
                // version; the group reports' names and sample_summary.csv
                // contents are what check the grouping
                'by_*/**/*_multiqc_report_{data,plots}/**',
            ])
            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assert workflow.success
            assertAll(
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/run_info/pipeline_info/threshold_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content
                ).match() }
            )
        }
    }
}
